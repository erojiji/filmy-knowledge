{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filmy.local/schema/1.0.0",
  "title": "Filmy Data release schema 1",
  "description": "Frozen game-facing contract. Required fields are schema 1; additive fields may be introduced in a minor revision after fixtures/films-0.1.0.json.",
  "type": "object",
  "required": ["schema_version", "release_version", "films"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "films": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/film"}}
  },
  "additionalProperties": true,
  "$defs": {
    "person": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "credits": {
      "type": "object",
      "required": ["lead", "colead", "director", "producer"],
      "properties": {
        "lead": {"type": "array", "items": {"$ref": "#/$defs/person"}},
        "colead": {"type": "array", "items": {"$ref": "#/$defs/person"}},
        "director": {"type": "array", "items": {"$ref": "#/$defs/person"}},
        "producer": {"type": "array", "items": {"$ref": "#/$defs/person"}}
      },
      "additionalProperties": true
    },
    "tag": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {"type": ["string", "boolean", "null"]},
        "label": {"type": ["string", "null"]},
        "confidence": {"enum": ["verified", "provisional", "auto"]},
        "review": {"enum": ["approved", "needs_review", "pending", "rejected"]},
        "source_url": {"type": ["string", "null"]},
        "retrieved_at": {"type": ["string", "null"]},
        "evidence_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "tags": {
      "type": "object",
      "required": ["verdict", "critics", "cult", "hyped", "award"],
      "properties": {
        "verdict": {"oneOf": [{"$ref": "#/$defs/tag"}, {"type": "null"}]},
        "critics": {"oneOf": [{"$ref": "#/$defs/tag"}, {"type": "null"}]},
        "cult": {"oneOf": [{"$ref": "#/$defs/tag"}, {"type": "null"}]},
        "hyped": {"oneOf": [{"$ref": "#/$defs/tag"}, {"type": "null"}]},
        "award": {"oneOf": [{"$ref": "#/$defs/tag"}, {"type": "null"}]}
      },
      "additionalProperties": true
    },
    "poster": {
      "type": "object",
      "required": ["url", "source", "status", "attribution"],
      "properties": {
        "url": {"type": ["string", "null"]},
        "source": {"type": "string"},
        "status": {"type": "string"},
        "attribution": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "film": {
      "type": "object",
      "required": ["id", "title", "year", "languages", "credits", "tags", "poster", "confidence", "review"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "languages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "credits": {"$ref": "#/$defs/credits"},
        "tags": {"$ref": "#/$defs/tags"},
        "poster": {"$ref": "#/$defs/poster"},
        "confidence": {"enum": ["verified", "provisional", "auto"]},
        "review": {"enum": ["approved", "needs_review", "pending", "rejected"]}
      },
      "additionalProperties": true
    }
  }
}
